{
  "name": "grouped-totals-grid",
  "version": "1.0.18",
  "description": "PCF dataset control that groups a model-driven view by any column (including lookups) and renders per-group and grand totals in the platform's own cell formatting.",
  "license": "MIT",
  "scripts": {
    "build": "pcf-scripts build",
    "build:prod": "pcf-scripts build --buildMode production",
    "rebuild:prod": "pcf-scripts clean && pcf-scripts build --buildMode production",
    "package": "dotnet build GroupedTotalsGridSolution --configuration Release -p:PcfEnableAutoNpmInstall=false",
    "package:dev": "dotnet build GroupedTotalsGridSolution --configuration Debug -p:PcfEnableAutoNpmInstall=false",
    "clean": "pcf-scripts clean",
    "rebuild": "pcf-scripts rebuild",
    "start": "pcf-scripts start",
    "start:watch": "pcf-scripts start watch",
    "refreshTypes": "pcf-scripts refreshTypes",
    "lint:no-raw-colors": "node ./scripts/check-no-raw-colors.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "pcf-scripts lint",
    "lint:fix": "pcf-scripts lint fix",
    "verify": "npm run lint:manifest && npm run lint:versions && npm run lint:no-raw-colors && npm run test && npm run build",
    "lint:manifest": "node ./scripts/check-manifest.js",
    "lint:versions": "node ./scripts/check-versions.js",
    "verify:prod": "npm run lint:manifest && npm run lint:versions && npm run lint:no-raw-colors && npm run test && npm run build:prod"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.54.0",
    "react": "^16.14.0",
    "react-dom": "^16.14.0"
  },
  "devDependencies": {
    "@jest/environment-jsdom-abstract": "^30.5.2",
    "@testing-library/react": "^12.1.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.0",
    "@types/powerapps-component-framework": "^1.3.15",
    "@types/react": "^16.14.60",
    "@types/react-dom": "^16.9.24",
    "eslint": "^9.39.0",
    "jest": "^30.5.2",
    "jsdom": "^30.1.1",
    "pcf-scripts": "^1",
    "pcf-start": "^1",
    "ts-jest": "^29.4.14",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.18.0"
  },
  "overrides": {
    "test-exclude": "^8.0.0"
  }
}
