pnpm-debug.log*

# Environment / secrets
.env
.env.*
!.env.example
*.pfx
*.snk

# Power Platform CLI local auth/profile data
.pac/

# Stray `pac` CLI output: if it runs with HOME unset or unexpanded (some
# non-interactive shells), it writes its user settings to a literal "~"
# directory here instead of the real home directory.
/~/

# Editor / IDE
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
.vs/
*.suo
*.user
