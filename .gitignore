# Dependencies
node_modules/
.pnp
.pnp.js

# PCF build output (pcf-scripts / MSBuild)
out/
bin/
obj/
**/generated/

# Solution packaging output (.cdsproj builds, pac solution pack)
*.zip
Solutions/**/bin/
Solutions/**/obj/

# GroupedTotalsGridSolution/ is the committed solution project; only its
# build output is ignored (covered by bin/, obj/ and *.zip above).

# Test coverage
coverage/
*.lcov
junit.xml

# Caches
.eslintcache
*.tsbuildinfo
.npm/
.cache/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
